{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOnlyForTradeMateSsmAuditEnvironment",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::661406600284:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:Iamgetty/TradeMate:environment:aws-ec2-ssm-audit"
        }
      }
    }
  ]
}