NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://trademate_app:local_dev_only@localhost:5432/trademate
MIGRATION_DATABASE_URL=postgresql://trademate_migrator:local_dev_only@localhost:5432/trademate
WORKER_DATABASE_URL=postgresql://trademate_worker:local_dev_only@localhost:5432/trademate

# Generate 32 random bytes and provide their 64-character hex encoding in the deployment secret store.
TOTP_ENCRYPTION_KEY=

# Explicitly opt in to the non-production identity-session sandbox; never enable as a live KYC provider.
SPORTS_TRANSFER_IDENTITY_PROVIDER=
SPORTS_TRANSFER_SANDBOX_ENABLED=false

# Sumsub Sandbox or Production credentials. Never commit real values.
# The app-token/secret pair determines Sandbox vs Production; keep both in the secret store.
SPORTS_TRANSFER_IDENTITY_PROVIDER=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_KYC_LEVEL_NAME=
SUMSUB_WEBHOOK_SECRET=
